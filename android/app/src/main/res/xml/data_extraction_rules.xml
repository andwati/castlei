<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the Castlei database (games, progress, settings) is
     backed up to the user's Google account and moved to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="castlei.sqlite"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="castlei.sqlite"/>
    </device-transfer>
</data-extraction-rules>
