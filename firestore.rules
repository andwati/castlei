rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backups: users/{uid}/backups/{id} (metadata) and .../chunks/{n} (<= ~750 KB each).
    // Each signed-in user can only touch their own data.
    match /users/{uid}/backups/{backupId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(
                                 ['created', 'games', 'app', 'reason', 'bytes', 'chunks', 'sha256'])
                            && request.resource.data.bytes is int
                            && request.resource.data.bytes <= 12 * 1024 * 1024;
      match /chunks/{chunkId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['i', 'data'])
                              && request.resource.data.data.size() <= 800 * 1024;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
