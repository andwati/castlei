rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backups: users/{uid}/backups/{id} (metadata) and .../chunks/{n} (<= ~750 KB each).
    // Each signed-in user can only touch their own data.
    match /users/{uid}/backups/{backupId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(
                                 ['created', 'games', 'app', 'reason', 'bytes', 'chunks', 'sha256'])
                            && request.resource.data.bytes is int
                            && request.resource.data.bytes <= 12 * 1024 * 1024;
      match /chunks/{chunkId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['i', 'data'])
                              && request.resource.data.data.size() <= 800 * 1024;
      }
    }
    // Feedback: create-only for any (including anonymous) signed-in client;
    // nobody can read it from the app. Screenshots are chunks (one JPEG each).
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['type', 'message', 'email', 'app', 'build', 'os',
                          'locale', 'uid', 'created', 'images', 'diagnostics'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type in ['bug', 'idea', 'other', 'diagnostics']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.diagnostics is string
                    && request.resource.data.diagnostics.size() <= 20000
                    && request.resource.data.images is int
                    && request.resource.data.images >= 0
                    && request.resource.data.images <= 3;
      match /chunks/{chunkId} {
        allow create: if request.auth != null
                      && chunkId in ['0', '1', '2']
                      && get(/databases/$(database)/documents/feedback/$(id)).data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['i', 'data'])
                      && request.resource.data.data.size() <= 800 * 1024;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
