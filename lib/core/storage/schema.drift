CREATE TABLE games (id TEXT NOT NULL PRIMARY KEY, title TEXT NOT NULL, source TEXT NOT NULL, root_fen TEXT NOT NULL, headers TEXT NOT NULL DEFAULT '{}', result TEXT NOT NULL DEFAULT '*', created INTEGER NOT NULL, updated INTEGER NOT NULL, favorite INTEGER NOT NULL DEFAULT 0, settings TEXT NOT NULL DEFAULT '{}', current_node TEXT, assisted INTEGER NOT NULL DEFAULT 0);
CREATE TABLE nodes (id TEXT NOT NULL PRIMARY KEY, game_id TEXT NOT NULL REFERENCES games(id) ON DELETE CASCADE, parent_id TEXT REFERENCES nodes(id) ON DELETE CASCADE, ordinal INTEGER NOT NULL, uci TEXT NOT NULL, san TEXT NOT NULL, comment TEXT NOT NULL DEFAULT '', nags TEXT NOT NULL DEFAULT '[]', annotations TEXT NOT NULL DEFAULT '[]', clocks TEXT NOT NULL DEFAULT '{}');
CREATE INDEX nodes_game ON nodes(game_id, parent_id, ordinal);
CREATE TABLE analysis (id TEXT NOT NULL PRIMARY KEY, game_id TEXT NOT NULL REFERENCES games(id) ON DELETE CASCADE, node_id TEXT NOT NULL REFERENCES nodes(id) ON DELETE CASCADE, config TEXT NOT NULL, data TEXT NOT NULL);
CREATE TABLE repertoires (id TEXT NOT NULL PRIMARY KEY, game_id TEXT NOT NULL REFERENCES games(id) ON DELETE CASCADE, side TEXT NOT NULL);
CREATE TABLE cards (id TEXT NOT NULL PRIMARY KEY, repertoire_id TEXT NOT NULL REFERENCES repertoires(id) ON DELETE CASCADE, fen TEXT NOT NULL, moves TEXT NOT NULL, stage INTEGER NOT NULL DEFAULT 0, due INTEGER NOT NULL DEFAULT 0);
CREATE TABLE puzzles (id TEXT NOT NULL PRIMARY KEY, pack TEXT NOT NULL, fen TEXT NOT NULL, moves TEXT NOT NULL, rating INTEGER NOT NULL, themes TEXT NOT NULL);
CREATE TABLE packs (id TEXT NOT NULL PRIMARY KEY, manifest TEXT NOT NULL);
CREATE TABLE attempts (id TEXT NOT NULL PRIMARY KEY, kind TEXT NOT NULL, target TEXT NOT NULL, created INTEGER NOT NULL, success INTEGER NOT NULL, hints INTEGER NOT NULL DEFAULT 0, duration INTEGER NOT NULL DEFAULT 0, metadata TEXT NOT NULL);
CREATE INDEX attempts_time ON attempts(created, kind);
CREATE TABLE preferences ("key" TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL);
